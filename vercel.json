{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "cookie", "key": "lang", "value": "en" }],
      "destination": "/en/",
      "permanent": false
    },
    {
      "source": "/",
      "missing": [{ "type": "cookie", "key": "lang" }],
      "has": [{ "type": "header", "key": "accept-language", "value": { "pre": "en" } }],
      "destination": "/en/",
      "permanent": false
    }
  ],
  "images": {
    "sizes": [256, 640, 1080],
    "formats": ["image/webp"],
    "minimumCacheTTL": 2678400,
    "remotePatterns": [
      { "protocol": "https", "hostname": "m.media-amazon.com", "pathname": "/images/**" }
    ]
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    }
  ]
}
